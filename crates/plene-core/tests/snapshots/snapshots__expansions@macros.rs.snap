  1 | // The arguments of standard macros that take expressions are expanded.
  2 | fn listed(a: &mut Vec<u8>, f: &mut Formatter<'_>) -> Result {
    | function listed(a: borrowed mutable Vec<u8>, f: borrowed mutable Formatter<lifetime inferred>) returns Result {
  3 |     assert!(!a.is_empty(), "{} left", a.len());
    |     assert!(not a.is_empty(), "{} left", a.len());
  4 |     assert_eq!(a.first(), Some(&1));
    |     assert_eq!(a.first(), Some(borrow 1));
  5 |     debug_assert_ne!(*a, vec![0; 3]);
    |     debug_assert_ne!(dereference a, vec![0; 3]);
  6 |     let halves = vec![&a[..2], &a[2..]];
    |     let halves = vec![borrow a[up to 2], borrow a[2 onward]];
  7 |     let masks = vec! { |x: u8| x & 1, |x: u8| x >> 1 };
    |     let masks = vec! { closure(x: u8) x bitwise and 1, closure(x: u8) x shift right 1 };
  8 |     println!();
  9 |     let total = std::format!("{n}", n = a.iter().map(|b| *b as u32).sum::<u32>());
    |     let total = std::format!("{n}", n = a.iter().map(closure(b) dereference b as u32).sum::<u32>());
 10 |     write!(
 11 |         f,
 12 |         "{}", // the count
 13 |         a.len()
 14 |     )?;
    |     ) or return early;
 15 |     Ok(())
 16 | }
 17 | 
 18 | // Arguments that do not parse as expressions, and other macros, are left alone.
 19 | fn unlisted(a: &u8) {
    | function unlisted(a: borrowed u8) {
 20 |     format!("{}", type = &a);
 21 |     stringify!(&a);
 22 |     assert_eq!(&a, T![_]);
    |     assert_eq!(borrow a, T![_]);
 23 |     assert!(matches!(a, &1 | &2));
 24 | }
